# Copy this file as a reference and configure values in Railway Variables.
# Never commit the populated .env file.
PLANILLA_MODE=web
APP_ENV=production
# Optional sandbox inbox: APP_ENV=test and ADMIN_TOKEN are required when set to 1.
# Use an isolated PLANILLA_DATA_DIR; never enable this flag in production.
PLANILLA_TEST_EMAIL=0
PUBLIC_BASE_URL=https://your-service.up.railway.app
PLANILLA_DATA_DIR=/data
PLANILLA_BACKGROUND_CLEANUP=1
PLANILLA_OCR_STORE=/data/aprendizaje-ocr.sqlite3

# Permanent link to the exact deployed Git revision and its source/build files.
# Railway provides RAILWAY_GIT_COMMIT_SHA; omit SOURCE_URL to use it automatically.
# Override only with the exact deployed revision when building elsewhere.
# SOURCE_URL=https://github.com/JuanHeis/planilla-pdf/tree/COMMIT

# Create these credentials in the owner's Mercado Pago application.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COLLECTOR_ID=

# Railway Hobby: use Resend HTTPS API with an owned, verified domain.
# Public Gmail addresses cannot be verified as a Resend sending domain.
RESEND_API_KEY=
EMAIL_FROM=Planilla <noreply@example.com>
# Gmail can receive support requests independently of verification delivery.
SUPPORT_EMAIL=

# Optional local / SMTP-enabled hosting alternative only.
# Railway Free, Trial and Hobby BLOCK outbound SMTP; Pro or above is required.
# Gmail requires a dedicated Google application password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=

# Generate a long random value and keep it separate from customer sessions.
ADMIN_TOKEN=

# Launch price is fixed in server code: ARS 2990, up to 5 pages.
